{
  "name": "nyaaywatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS-backed published snapshot storage slice for NyaayWatch",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/src/db/migrations && cp src/db/migrations/*.sql dist/src/db/migrations/ && mkdir -p dist/fixtures && cp -R fixtures/himachal dist/fixtures/himachal",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:persistent": "vitest run tests/persistent-stack.integration.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/dev/seed.ts",
    "dev:bootstrap": "tsx src/dev/bootstrap.ts",
    "operator:fetch": "tsx src/dev/operator.ts fetch",
    "operator:inspect": "tsx src/dev/operator.ts inspect",
    "operator:publications": "tsx src/dev/operator.ts publications",
    "operator:publish": "tsx src/dev/operator.ts publish",
    "operator:replay": "tsx src/dev/operator.ts replay",
    "operator:rollback": "tsx src/dev/operator.ts rollback",
    "operator:remote": "tsx src/dev/operator-remote.ts",
    "operator:staging": "tsx src/dev/staging-operator.ts",
    "release:prepublish": "tsx src/dev/release-prepublish.ts",
    "release:postpublish": "tsx src/dev/release-postpublish.ts",
    "release:record": "tsx src/dev/release-record.ts",
    "release:verify": "tsx src/dev/release-verify.ts",
    "docker:up": "docker compose up -d --wait postgres localstack",
    "docker:down": "docker compose down -v"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pg-mem": "^3.0.5",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.59.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
