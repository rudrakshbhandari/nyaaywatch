{
  "name": "nyaaywatch",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Reviewed, versioned snapshots of pending caseloads, clearance rates, and wait times across India's courts — drawn from public NJDG data.",
  "homepage": "https://nyaaywatch.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/rudrakshbhandari/nyaaywatch.git"
  },
  "author": "NyaayWatch Contributors",
  "keywords": ["india", "judiciary", "court-data", "transparency", "njdg", "open-data"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/src/db/migrations && cp src/db/migrations/*.sql dist/src/db/migrations/ && mkdir -p dist/fixtures && cp -R fixtures/. dist/fixtures/ && mkdir -p dist/assets/fonts && cp assets/fonts/* dist/assets/fonts/",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:persistent": "vitest run tests/persistent-stack.integration.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/dev/seed.ts",
    "dev:bootstrap": "tsx src/dev/bootstrap.ts",
    "operator:fetch": "tsx src/dev/operator.ts fetch",
    "operator:inspect": "tsx src/dev/operator.ts inspect",
    "operator:publications": "tsx src/dev/operator.ts publications",
    "operator:publish": "tsx src/dev/operator.ts publish",
    "operator:replay": "tsx src/dev/operator.ts replay",
    "operator:rollback": "tsx src/dev/operator.ts rollback",
    "operator:remote": "tsx src/dev/operator-remote.ts",
    "operator:production": "tsx src/dev/staging-operator.ts --stack nyaaywatch-production",
    "operator:staging": "tsx src/dev/staging-operator.ts",
    "infra:production-preflight": "bash infra/aws/staging/production-cutover-preflight.sh",
    "infra:production-cutover-inventory": "bash infra/aws/staging/production-cutover-inventory.sh",
    "operator:reconcile-fetch-schedule": "bash infra/aws/staging/reconcile-internal-fetch-schedule.sh",
    "release:prepublish": "tsx src/dev/release-prepublish.ts",
    "release:postpublish": "tsx src/dev/release-postpublish.ts",
    "release:record": "tsx src/dev/release-record.ts",
    "release:purge-public-routes": "tsx src/dev/release-purge-public-routes.ts",
    "release:verify": "tsx src/dev/release-verify.ts",
    "screenshots:linkedin": "node scripts/shoot-nyaaywatch.mjs",
    "high-court:readiness": "tsx src/dev/high-court-readiness.ts",
    "high-court:wave-readiness": "tsx src/dev/high-court-wave-readiness.ts",
    "ops:verify-public-alpha": "tsx src/dev/ops-verify-public-alpha.ts",
    "ops:verify-internal-fetch-schedule": "tsx src/dev/ops-verify-internal-fetch-schedule.ts",
    "ops:njdg-missing-zero-outreach": "tsx src/dev/njdg-missing-zero-outreach.ts",
    "ops:publish-pending": "tsx src/dev/ecs-publish-pending-entrypoint.ts",
    "docker:up": "docker compose up -d --wait postgres localstack",
    "docker:down": "docker compose down -v"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/client-ses": "^3.1038.0",
    "@aws-sdk/client-sns": "^3.1038.0",
    "@resvg/resvg-js": "^2.6.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pg-mem": "^3.0.5",
    "satori": "^0.26.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.59.1",
    "@types/express": "^5.0.3",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
