NODE_ENV=development
PORT=3000
POSTGRES_PORT=5432
AZURITE_BLOB_PORT=10000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nyaaywatch
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=artifacts
DEPLOY_ENV=dev
OPERATOR_API_TOKEN=operator-test-token
STATE_CODE=HP
CANONICAL_HOST=nyaaywatch.in
PUBLIC_BASE_URL=https://nyaaywatch.in
LEGACY_HOSTS=nyaaywatch.com,www.nyaaywatch.com
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=nyaaywatch.in
# Cloudflare Web Analytics — visitor counts, page views, referrers (production only)
CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# NJDG missing-zero outreach (production/manual only)
AZURE_EMAIL_SENDER=data@nyaaywatch.in
NJDG_OUTREACH_SENDER=data@outreach.nyaaywatch.in
NJDG_OUTREACH_REPLY_TO=
NJDG_OUTREACH_TO=
NJDG_OUTREACH_BCC=

# App mode — set to "preview" for preview deployments; leave empty for default
APP_MODE=

# Base URL for operator dev scripts (e.g. https://nyaaywatch.in or http://localhost:3000)
BASE_URL=

# State and court slugs for operator scripts (e.g. "himachal", "himachal-high-court")
STATE_SLUG=
HIGH_COURT_SLUG=
SUPREME_COURT_ENABLED=false

# Remote operator connection (used by operator:remote)
OPERATOR_BASE_URL=
OPERATOR_CONNECT_HOST=
OPERATOR_CONNECT_PORT=

# Azure production resource group used by the internal schedule watchdog
AZURE_RESOURCE_GROUP=nyaaywatch-production
