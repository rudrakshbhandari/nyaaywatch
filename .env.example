NODE_ENV=development
PORT=3000
POSTGRES_PORT=5432
LOCALSTACK_PORT=4566
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nyaaywatch
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL_S3=http://127.0.0.1:4566
AWS_S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=nyaaywatch-dev-artifacts-local
DEPLOY_ENV=dev
OPERATOR_API_TOKEN=operator-test-token
STATE_CODE=HP
CANONICAL_HOST=nyaaywatch.in
PUBLIC_BASE_URL=https://nyaaywatch.in
LEGACY_HOSTS=nyaaywatch.com,www.nyaaywatch.com
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=nyaaywatch.in

# App mode — set to "preview" for preview deployments; leave empty for default
APP_MODE=

# Base URL for operator dev scripts (e.g. https://nyaaywatch.in or http://localhost:3000)
BASE_URL=

# State and court slugs for operator scripts (e.g. "himachal", "himachal-high-court")
STATE_SLUG=
HIGH_COURT_SLUG=
SUPREME_COURT_ENABLED=false

# Remote operator connection (used by operator:remote)
OPERATOR_BASE_URL=
OPERATOR_CONNECT_HOST=
OPERATOR_CONNECT_PORT=

# AWS CloudWatch RUM — browser monitoring (production only; leave empty for local dev)
AWS_RUM_APP_MONITOR_ID=
AWS_RUM_IDENTITY_POOL_ID=

# Internal fetch schedule watchdog (AWS EventBridge Scheduler stack names)
STACK_NAME=
INTERNAL_FETCH_SCHEDULE_GROUP_NAME=
STATE_INTERNAL_FETCH_SCHEDULE_NAME=
SUPREME_COURT_INTERNAL_FETCH_SCHEDULE_NAME=
HIGH_COURT_INTERNAL_FETCH_SCHEDULE_NAME=
